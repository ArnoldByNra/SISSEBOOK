<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Reportes: pestaña "libros más solicitados" y "lectores con préstamos vencidos". -->
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="sissepbook.frontend.controller.ReportesController" styleClass="contenido">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Button text="← Menú" onAction="#volver"/>
            <Label text="Reportes" styleClass="titulo-seccion"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" onAction="#actualizar" styleClass="btn-primario"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <Tab text="Libros más solicitados">
                <TableView fx:id="tablaLibros">
                    <columns>
                        <TableColumn fx:id="colLTitulo" text="Título" prefWidth="240"/>
                        <TableColumn fx:id="colLAutor" text="Autor" prefWidth="180"/>
                        <TableColumn fx:id="colLCategoria" text="Categoría" prefWidth="140"/>
                        <TableColumn fx:id="colLTotal" text="Préstamos" prefWidth="100"/>
                        <TableColumn fx:id="colLLectores" text="Lectores" prefWidth="90"/>
                        <TableColumn fx:id="colLDisp" text="Disponibles" prefWidth="100"/>
                    </columns>
                </TableView>
            </Tab>
            <Tab text="Lectores con préstamos vencidos">
                <TableView fx:id="tablaLectores">
                    <columns>
                        <TableColumn fx:id="colLMatricula" text="Matrícula" prefWidth="140"/>
                        <TableColumn fx:id="colLNombre" text="Nombre" prefWidth="240"/>
                        <TableColumn fx:id="colLPendientes" text="Pendientes" prefWidth="110"/>
                        <TableColumn fx:id="colLMaxDias" text="Máx. días retraso" prefWidth="140"/>
                        <TableColumn fx:id="colLTotalDias" text="Total días retraso" prefWidth="150"/>
                    </columns>
                </TableView>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
